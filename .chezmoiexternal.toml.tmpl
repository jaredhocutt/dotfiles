[".tmux"]
    type = "git-repo"
    url = "https://github.com/gpakosz/.tmux.git"
    refreshPeriod = "168h"

{{- $fontDir := "" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $fontDir = "Library/Fonts" }}
{{- else if eq .chezmoi.os "linux" }}
{{-   $fontDir = ".local/share/fonts" }}
{{- end }}
{{- range (list "Regular" "Bold" "Italic" "Bold Italic") }}
["{{ $fontDir }}/MesloLGS NF {{ . }}.ttf"]
    type = "file"
    url = "https://github.com/romkatv/powerlevel10k-media/raw/master/MesloLGS NF {{ . }}.ttf"
    refreshPeriod = "168h"
{{- end }}

[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".oh-my-zsh/custom/plugins/zsh-autocomplete"]
    type = "archive"
    url = "https://github.com/marlonrichert/zsh-autocomplete/archive/{{ (gitHubLatestRelease "marlonrichert/zsh-autocomplete").TagName }}.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".oh-my-zsh/custom/plugins/zsh-autosuggestions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-autosuggestions/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".oh-my-zsh/custom/plugins/zsh-syntax-highlighting"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-syntax-highlighting/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".oh-my-zsh/custom/themes/powerlevel10k"]
    type = "archive"
    url = "https://github.com/romkatv/powerlevel10k/archive/{{ (gitHubLatestRelease "romkatv/powerlevel10k").TagName }}.tar.gz"
	exact = true
    stripComponents = 1

[".nvm"]
    type = "git-repo"
    url = "https://github.com/nvm-sh/nvm.git"
    refreshPeriod = "168h"
    revision = "{{ (gitHubLatestRelease "nvm-sh/nvm").TagName }}"


{{- /* macOS gets uv from Homebrew */}}
{{- if eq .chezmoi.os "linux" }}
{{-   $uvArch := get (dict "amd64" "x86_64" "arm64" "aarch64") .chezmoi.arch }}
{{-   if not $uvArch }}{{ fail (printf "no uv release build for arch %q" .chezmoi.arch) }}{{ end }}
{{-   $uvTriple := printf "%s-unknown-linux-gnu" $uvArch }}
{{-   $uvVersion := (gitHubLatestRelease "astral-sh/uv").TagName }}
{{-   range list "uv" "uvx" }}
[".local/bin/{{ . }}"]
    type = "archive-file"
    url = "https://github.com/astral-sh/uv/releases/download/{{ $uvVersion }}/uv-{{ $uvTriple }}.tar.gz"
    path = "uv-{{ $uvTriple }}/{{ . }}"
    executable = true
    refreshPeriod = "168h"
{{-   end }}
{{- end }}

{{- /* sdk-sm publishes several release trains (rust-v*, python-v*,
       bws-v*), so gitHubLatestRelease returns the wrong one -- pick the newest
       bws-v* release instead. The "bws-v" prefix is deliberate: a bare "bws-"
       would also match the legacy bws-cli-v* tags. */}}
{{- $bwsTag := "" }}
{{- range (gitHubReleases "bitwarden/sdk-sm") }}
{{-   if and (not $bwsTag) (hasPrefix "bws-v" .TagName) }}{{ $bwsTag = .TagName }}{{ end }}
{{- end }}
{{- if not $bwsTag }}{{ fail "no bws-v* release found for bitwarden/sdk-sm" }}{{ end }}
{{- $bwsVersion := trimPrefix "bws-v" $bwsTag }}
{{- $bwsOS := get (dict "linux" "unknown-linux-gnu" "darwin" "apple-darwin") .chezmoi.os }}
{{- $bwsArch := get (dict "amd64" "x86_64" "arm64" "aarch64") .chezmoi.arch }}
{{- if or (not $bwsOS) (not $bwsArch) }}{{ fail (printf "no bws release build for %s/%s" .chezmoi.os .chezmoi.arch) }}{{ end }}
[".local/bin/bws"]
    type = "archive-file"
    url = "https://github.com/bitwarden/sdk-sm/releases/download/{{ $bwsTag }}/bws-{{ $bwsArch }}-{{ $bwsOS }}-{{ $bwsVersion }}.zip"
    path = "bws"
    executable = true
    refreshPeriod = "168h"
